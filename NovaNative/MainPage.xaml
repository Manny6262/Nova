<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="NovaNative.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RequestedTheme="Dark" Background="#071123">
  <Page.Resources>
    <Style x:Key="NavStyle" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Margin" Value="0,3,0,3"/>
      <Setter Property="Padding" Value="15,0"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#C5D5F1"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="CanvasTabStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#B7C9E9"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CornerRadius" Value="5"/>
    </Style>
  </Page.Resources>
  <Grid x:Name="LayoutRoot" SizeChanged="LayoutRoot_SizeChanged" KeyDown="LayoutRoot_KeyDown">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="NavColumn" Width="208"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition x:Name="CanvasColumn" Width="330"/>
    </Grid.ColumnDefinitions>
    <Image Grid.ColumnSpan="3" Source="ms-appx:///Assets/observation-deck.png" Stretch="UniformToFill" Opacity="0.94" IsHitTestVisible="False"/>
    <Rectangle Grid.ColumnSpan="3" IsHitTestVisible="False">
      <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#18050D1D" Offset="0"/><GradientStop Color="#7D06142A" Offset="0.2"/><GradientStop Color="#65061226" Offset="0.7"/><GradientStop Color="#66071327" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
    </Rectangle>
    <Canvas x:Name="Starfield" Grid.ColumnSpan="3" Opacity="0.25" IsHitTestVisible="False"/>

    <!-- The left rail is a real native navigation surface over the observation window. -->
    <Border Grid.Column="0" Background="#B90B1931" BorderBrush="#527CB7" BorderThickness="0,0,1,0">
      <Grid Margin="12,21,13,15">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="12,4,0,35" VerticalAlignment="Center">
          <TextBlock Text="✦" FontSize="28" Foreground="#B4ECFF" Margin="0,0,13,0"/>
          <StackPanel x:Name="BrandText" VerticalAlignment="Center"><TextBlock Text="N O V A" Foreground="#F6F8FF" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="PERSONAL INTELLIGENCE" Foreground="#9AB5D9" FontSize="8" CharacterSpacing="85"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="2">
          <Button x:Name="NewChatButton" Content="＋   New conversation" Click="NewChatButton_Click" Height="44" Margin="1,0,1,18" HorizontalAlignment="Stretch" Background="#283D67" Foreground="#F3F7FF" BorderBrush="#627DB0" BorderThickness="1" CornerRadius="10"/>
          <Button x:Name="ChatNav" Content="✧    Chat" Click="NavButton_Click" Tag="Chat" Style="{StaticResource NavStyle}" Background="#354B8C" BorderBrush="#796FFF" BorderThickness="1"/>
          <Button x:Name="StudioNav" Content="◈    Studio" Click="NavButton_Click" Tag="Studio" Style="{StaticResource NavStyle}"/>
          <Button x:Name="LibraryNav" Content="▣    Library" Click="NavButton_Click" Tag="Library" Style="{StaticResource NavStyle}"/>
          <Button x:Name="TasksNav" Content="◷    Tasks" Click="NavButton_Click" Tag="Tasks" Style="{StaticResource NavStyle}"/>
          <Button x:Name="SettingsNav" Content="⚙    Settings" Click="NavButton_Click" Tag="Settings" Style="{StaticResource NavStyle}"/>
          <TextBlock x:Name="RecentHeading" Text="RECENT" Foreground="#99AFD2" FontSize="10" CharacterSpacing="140" Margin="15,24,0,10"/>
        </StackPanel>
        <ScrollViewer x:Name="SessionsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SessionsList"/></ScrollViewer>
        <StackPanel Grid.Row="3" Margin="10,10,0,0" Spacing="5">
          <TextBlock x:Name="EngineStatus" Text="Checking Nova engine…" Foreground="#8FF0D5" FontSize="11" TextWrapping="Wrap"/>
          <Button x:Name="RetryEngineButton" Content="Retry connection" Click="RetryEngineButton_Click" Visibility="Collapsed" HorizontalAlignment="Left" Background="#283D67" Foreground="#F3F7FF" BorderBrush="#627DB0" BorderThickness="1" FontSize="11" Padding="8,4"/>
          <TextBlock x:Name="RailPrivacy" Text="Private · On your PC" Foreground="#91A9D0" FontSize="10"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Conversation space: wide greeting, live voice core, readable messages. -->
    <Grid Grid.Column="1" Margin="24,14,19,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="VoiceHeader" Height="172">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="VoiceColumn" Width="390"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="3,0,0,5">
          <TextBlock x:Name="WelcomeTitle" Text="Good evening, User" Foreground="#F4F6FF" FontSize="35" FontWeight="Light" TextWrapping="Wrap"/>
          <TextBlock Text="I D E A S   →   P L A N S   →   R E A L   R E S U L T S" Foreground="#9AB4DC" FontSize="9" Margin="2,13,0,0"/>
        </StackPanel>
        <Grid Grid.Column="1" VerticalAlignment="Center" Height="166">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="OrbitColumn" Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Viewbox x:Name="OrbViewbox" Width="225" Height="166" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Viewbox.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Viewbox.RenderTransform>
            <Grid Width="225" Height="166" IsHitTestVisible="False">
              <Ellipse x:Name="CoreAura" Width="117" Height="117" Opacity="0.62" RenderTransformOrigin="0.5,0.5"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#514A42E4" Offset="0"/><GradientStop Color="#22355FC9" Offset="0.57"/><GradientStop Color="#002A3F83" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform></Ellipse>
              <Ellipse x:Name="OuterGlow" Width="216" Height="94" Stroke="#936FFF" StrokeThickness="5" Opacity="0.26" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-18"/></Ellipse.RenderTransform></Ellipse>
              <Ellipse x:Name="SecondGlow" Width="205" Height="105" Stroke="#40BCFF" StrokeThickness="5" Opacity="0.22" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="8"/></Ellipse.RenderTransform></Ellipse>
              <Ellipse x:Name="ThirdGlow" Width="122" Height="122" Stroke="#6E73FF" StrokeThickness="4" Opacity="0.09" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="0"/></Ellipse.RenderTransform></Ellipse>
              <Ellipse x:Name="OuterRing" Width="216" Height="94" StrokeThickness="1.35" Opacity="0.9" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Stroke><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#835BEA" Offset="0"/><GradientStop Color="#BA91FF" Offset="0.36"/><GradientStop Color="#E6C9FF" Offset="0.76"/><GradientStop Color="#777BFF" Offset="1"/></LinearGradientBrush></Ellipse.Stroke>
                <Ellipse.RenderTransform><RotateTransform Angle="-18"/></Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse x:Name="SecondRing" Width="205" Height="105" StrokeThickness="1.25" Opacity="0.82" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3A8BEF" Offset="0"/><GradientStop Color="#69CEFF" Offset="0.42"/><GradientStop Color="#B0E8FF" Offset="0.78"/><GradientStop Color="#3E90F9" Offset="1"/></LinearGradientBrush></Ellipse.Stroke>
                <Ellipse.RenderTransform><RotateTransform Angle="8"/></Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse x:Name="ThirdRing" Width="122" Height="122" Stroke="#627BFF" StrokeThickness="0.95" Opacity="0.36" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="0"/></Ellipse.RenderTransform></Ellipse>
              <Ellipse x:Name="DashedRing" Width="213" Height="87" Stroke="#817EFF" StrokeThickness="0.9" StrokeDashArray="2,6" Opacity="0.5" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="18"/></Ellipse.RenderTransform></Ellipse>
              <Canvas x:Name="OrbitParticles" Width="225" Height="166" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <StackPanel x:Name="WaveBars" Orientation="Horizontal" Width="192" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3" Opacity="0"/>
              <Ellipse x:Name="CoreGlow" Width="94" Height="94" Opacity="0.62" RenderTransformOrigin="0.5,0.5"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#AD8C7CFF" Offset="0"/><GradientStop Color="#765C70EA" Offset="0.58"/><GradientStop Color="#004BD0FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform></Ellipse>
              <Grid x:Name="CoreVisual" Width="84" Height="84" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                <Image Source="ms-appx:///Assets/voice-core-glass.png" Width="84" Height="84" Stretch="Uniform"/>
                <TextBlock x:Name="OrbGlyph" Text="✦" Foreground="White" FontSize="13" Opacity="0.9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Grid>
          </Viewbox>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0" Spacing="7">
            <TextBlock x:Name="VoiceStateLabel" Text="Idle · ready" Foreground="#E3E9FF" FontSize="13"/>
            <TextBlock x:Name="VoiceHint" Text="Speak naturally…" Foreground="#91A9CE" FontSize="11"/>
          </StackPanel>
        </Grid>
        <Button x:Name="CanvasToggle" Grid.Column="1" Content="▣  Canvas" Click="CanvasToggle_Click" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#273F6B" BorderBrush="#598BDA" Foreground="White" BorderThickness="1" CornerRadius="10"/>
      </Grid>
      <Rectangle Grid.Row="1" Height="1" Fill="#48648C" Opacity="0.55" Margin="1,0,1,11"/>
      <Border x:Name="ConversationPanel" Grid.Row="2" Background="#7C0A172C" BorderBrush="#405B82" BorderThickness="1" CornerRadius="14">
        <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto" Padding="17,16"><StackPanel x:Name="ConversationList" Spacing="20"/></ScrollViewer>
      </Border>
      <Border x:Name="SectionPanel" Grid.Row="2" Visibility="Collapsed" Background="#C50A172C" BorderBrush="#526F9C" BorderThickness="1" CornerRadius="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20"><StackPanel x:Name="SectionContent" Spacing="16"/></ScrollViewer>
      </Border>
      <Border x:Name="ComposerPanel" Grid.Row="3" Background="#E00E203B" BorderBrush="#82B5F5" BorderThickness="1.4" CornerRadius="19" Margin="0,12,0,8" Padding="8">
        <Grid MinHeight="59">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="AttachButton" Grid.Column="0" Content="♧" Click="AttachButton_Click" ToolTipService.ToolTip="Attach a file or image" Width="39" Height="39" Background="Transparent" Foreground="#CFE4FF" BorderThickness="0" FontSize="22" VerticalAlignment="Center"/>
          <TextBox x:Name="Composer" Grid.Column="1" PlaceholderText="What would you like to make today?" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="120" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#EEF5FF" FontSize="14" KeyDown="Composer_KeyDown"/>
          <Button x:Name="VoiceButton" Grid.Column="2" Content="🎙" Click="VoiceButton_Click" ToolTipService.ToolTip="Dictate a message" AutomationProperties.Name="Dictate a message" Width="42" Height="42" Background="Transparent" Foreground="#CEE9FF" BorderThickness="0" FontSize="18" VerticalAlignment="Center"/>
          <Button x:Name="SendButton" Grid.Column="3" Content="↑" Click="SendButton_Click" Width="40" Height="40" Background="#7166E5" Foreground="White" BorderThickness="0" CornerRadius="20" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <Grid Grid.Row="4" MinHeight="34">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="ModelPicker" Width="176" Height="30" FontSize="11" SelectionChanged="ModelPicker_SelectionChanged" PlaceholderText="Choose a model" Background="#A10E203B" BorderBrush="#5A7AAE"/>
        <Button Grid.Column="1" Content="✧  Permissions" Margin="9,0,0,0" Background="#80102442" BorderBrush="#39517A" Foreground="#C4D4F3" BorderThickness="1" FontSize="11" Height="30">
          <Button.Flyout><Flyout Placement="Top"><StackPanel Spacing="5" MinWidth="210">
            <TextBlock Text="NOVA CONTROLS" Foreground="#B5C8E9" FontSize="11" Margin="7,2,0,6"/>
            <CheckBox x:Name="ToolsToggle" Content="Web tools" IsChecked="False"/>
            <CheckBox x:Name="ActionToggle" Content="File / code actions" IsChecked="False"/>
            <CheckBox x:Name="ComputerToggle" Content="Computer control" IsChecked="False"/>
            <Button x:Name="MotionButton" Content="Motion: on" Click="MotionButton_Click" HorizontalAlignment="Stretch"/>
          </StackPanel></Flyout></Button.Flyout>
        </Button>
        <Button x:Name="VoiceModeButton" Grid.Column="2" Content="◉  Voice mode" Click="VoiceModeButton_Click" ToolTipService.ToolTip="Start a spoken conversation with Nova" AutomationProperties.Name="Voice mode" Margin="9,0,0,0" Background="#80102442" BorderBrush="#796FFF" Foreground="#DCD6FF" BorderThickness="1" FontSize="11" Height="30"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6" Margin="6,0,10,0">
          <ProgressRing x:Name="ChatProgress" IsActive="True" Visibility="Collapsed" Width="16" Height="16" AutomationProperties.Name="Reply in progress"/>
          <TextBlock x:Name="TurnStatus" Text="Ready" Foreground="#9FB6DB" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
          <Button x:Name="RetryButton" Content="Retry" Click="RetryButton_Click" Visibility="Collapsed" Background="#283D67" Foreground="#F3F7FF" FontSize="11" Padding="8,3" AutomationProperties.Name="Retry restored draft"/>
        </StackPanel>
        <TextBlock x:Name="FooterPrivacy" Grid.Column="4" Text="◈  Private · On your PC" Foreground="#A6BADB" FontSize="10" VerticalAlignment="Center"/>
      </Grid>
    </Grid>

    <!-- Framed right canvas; on compact windows it becomes the same overlay. -->
    <Border x:Name="CanvasPanel" Grid.Column="2" Margin="3,9,12,10" Background="#ED0A1A32" BorderBrush="#77B5F3" BorderThickness="1.4" CornerRadius="20">
      <Grid Margin="15,16,15,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Height="31"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="CONTEXT CANVAS" Foreground="#DDEAFF" FontSize="11" FontWeight="SemiBold" CharacterSpacing="130" VerticalAlignment="Center" Margin="7,0,0,0"/>
          <Button x:Name="CanvasClose" Grid.Column="1" Content="✕" Click="CanvasToggle_Click" Visibility="Collapsed" Background="Transparent" Foreground="#CAD9F3" BorderThickness="0"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,9,0,14">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ContextTab" Content="Context" Tag="Context" Click="CanvasTab_Click" Style="{StaticResource CanvasTabStyle}"/><Button x:Name="ToolsTab" Content="Tools" Tag="Tools" Click="CanvasTab_Click" Style="{StaticResource CanvasTabStyle}"/><Button x:Name="NotesTab" Content="Notes" Tag="Notes" Click="CanvasTab_Click" Style="{StaticResource CanvasTabStyle}"/></StackPanel>
          <Rectangle Grid.Row="1" Height="2" Fill="#6C8FB9" Opacity="0.7"/>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CanvasContent" Spacing="11" Margin="2,0"/></ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Page>
